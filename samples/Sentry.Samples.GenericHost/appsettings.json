{
  "Logging": {
    "LogLevel": {
      "Default": "Trace"
    },
    // Which log entries the Sentry logger provider turns into breadcrumbs, events and structured logs
    "Sentry": {
      "LogLevel": {
        "Default": "Information" // Configure structured logs
      },
      "MinimumBreadcrumbLevel": "Debug",
      "MinimumEventLevel": "Warning"
    }
  },
  // Sentry SDK options, read by UseSentry
  "Sentry": {
    // Send user name and machine name
    "SendDefaultPii": true,
    // Also send ILogger entries to Sentry as structured logs. This is off by default.
    "EnableLogs": true
  }
}
