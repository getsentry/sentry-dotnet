<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks Condition="'$(NO_IOS)' == '' And '$(NO_MACCATALYST)' == ''">$(PreviousIosTfm);$(PreviousMacCatalystTfm)</TargetFrameworks>
    <TargetFrameworks Condition="'$(NO_IOS)' == '' And '$(NO_MACCATALYST)' == 'true'">$(PreviousIosTfm)</TargetFrameworks>
    <TargetFrameworks Condition="'$(NO_IOS)' == 'true' And '$(NO_MACCATALYST)' == ''">$(PreviousMacCatalystTfm)</TargetFrameworks>
    <IsBindingProject>true</IsBindingProject>
    <MtouchNoSymbolStrip>true</MtouchNoSymbolStrip>
    <Description>.NET Bindings for the Sentry Cocoa SDK</Description>
    <SentryCocoaCache>..\..\modules\sentry-cocoa\</SentryCocoaCache>
    <!-- SentrySpan.g.cs: error CS0108: 'ISentrySpan.Serialize()' hides inherited member 'ISentrySerializable.Serialize()'. Use the new keyword if hiding was intended -->
    <NoWarn>$(NoWarn);CS0108</NoWarn>
  </PropertyGroup>

  <!-- The .NET SDK consumes a single self-contained SentryObjC-Dynamic xcframework (the SentryObjC*
       API surface with the engine baked in). By default we download the pre-built release artifact
       named in modules/sentry-cocoa.properties; set -p:BuildCocoaSdkFromSource=true to build it from
       the modules/sentry-cocoa submodule instead (e.g. to add native debug logging while diagnosing
       an issue). Both paths produce the same Carthage/Build-<platform>/SentryObjC-Dynamic.xcframework
       + Carthage/Headers layout. See getsentry/sentry-dotnet#5492. -->
  <PropertyGroup>
    <BuildCocoaSdkFromSource Condition="'$(BuildCocoaSdkFromSource)' == ''">false</BuildCocoaSdkFromSource>
    <SentryCocoaFramework>$(SentryCocoaCache)Carthage\Build-$(TargetPlatformIdentifier)\SentryObjC-Dynamic.xcframework</SentryCocoaFramework>
    <SentryCocoaBindingInputs>../../scripts/generate-cocoa-bindings.ps1;$(SentryCocoaCache)Carthage/Headers/**/*.h</SentryCocoaBindingInputs>
  </PropertyGroup>

  <!-- From-source only: resolve modules/sentry-cocoa/.git so the build can be keyed on its HEAD. -->
  <PropertyGroup Condition="'$(BuildCocoaSdkFromSource)' == 'true' And Exists('$(SentryCocoaCache).git')">
    <SentryCocoaGitFile>$([MSBuild]::NormalizePath($(MSBuildThisFileDirectory), $(SentryCocoaCache).git))</SentryCocoaGitFile>
    <!-- Standalone clone: .git is a directory -->
    <SentryCocoaGitDir Condition="Exists('$(SentryCocoaCache).git\HEAD')">.git</SentryCocoaGitDir>
    <!-- Submodule: .git is a file pointing at the real gitdir -->
    <SentryCocoaGitDir Condition="'$(SentryCocoaGitDir)' == ''">$([System.IO.File]::ReadAllText('$(SentryCocoaGitFile)').Trim().Replace('gitdir: ', ''))</SentryCocoaGitDir>
  </PropertyGroup>

  <!-- Build empty assemblies when not on macOS, to pass the solution build. -->
  <ItemGroup Condition="!$([MSBuild]::IsOSPlatform('OSX'))">
    <Compile Remove="*" />
    <Using Remove="*" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Sentry" PublicKey="$(SentryPublicKey)" />
    <InternalsVisibleTo Include="Sentry.Testing" PublicKey="$(SentryPublicKey)" />
    <InternalsVisibleTo Include="Sentry.Tests" PublicKey="$(SentryPublicKey)" />
    <InternalsVisibleTo Include="Sentry.Extensions.Logging.Tests" PublicKey="$(SentryPublicKey)" />
    <InternalsVisibleTo Include="Sentry.Maui.Tests" PublicKey="$(SentryPublicKey)" />
  </ItemGroup>

  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('OSX'))">

    <!-- Set up the binding project. -->
    <ObjcBindingApiDefinition Include="ApiDefinitions.cs" />
    <ObjcBindingCoreSource Include="StructsAndEnums.cs" />
    <NativeReference Include="$(SentryCocoaFramework)" Kind="Framework" />

    <!-- Use a separate readme file in the nuget. -->
    <None Remove="$(MSBuildThisFileDirectory)..\..\README.md" />
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="" />

    <!-- Don't add the changelog to the nuget. -->
    <PackageReference Remove="SIL.ReleaseTasks" />

    <!-- Include our transitive build targets in the nuget. -->
    <None Include="buildTransitive\Sentry.Bindings.Cocoa.targets" Pack="true" PackagePath="buildTransitive\Sentry.Bindings.Cocoa.targets" />
  </ItemGroup>

  <!-- Default: download the pre-built self-contained SentryObjC-Dynamic xcframework (no submodule needed). -->
  <Target Name="_DownloadCocoaSDK"
          Condition="$([MSBuild]::IsOSPlatform('OSX')) And '$(BuildCocoaSdkFromSource)' != 'true'"
          Inputs="..\..\modules\sentry-cocoa.properties;..\..\scripts\download-sentry-cocoa.sh" Outputs="..\..\modules\sentry-cocoa\Carthage\.downloaded-version">

    <Message Importance="High" Text="Downloading the pre-built Cocoa SDK (SentryObjC-Dynamic)." />
    <Exec Command="bash ../../scripts/download-sentry-cocoa.sh" IgnoreStandardErrorWarningFormat="true" />
  </Target>

  <!-- Toggle (-p:BuildCocoaSdkFromSource=true): build SentryObjC-Dynamic from the submodule source. -->
  <Target Name="_BuildCocoaSDK"
          Condition="$([MSBuild]::IsOSPlatform('OSX')) And '$(BuildCocoaSdkFromSource)' == 'true'"
          Inputs="$(SentryCocoaCache)$(SentryCocoaGitDir)\HEAD;..\..\scripts\build-sentry-cocoa.sh" Outputs="..\..\modules\sentry-cocoa\Carthage\.built-from-sha">

    <Error Condition="!Exists('$(SentryCocoaCache).git')"
           Text="BuildCocoaSdkFromSource=true requires the modules/sentry-cocoa submodule. Run 'git submodule update --init modules/sentry-cocoa'." />
    <Message Importance="High" Text="Building the Cocoa SDK from source (SentryObjC-Dynamic)." />
    <Exec Command="bash ../../scripts/build-sentry-cocoa.sh" IgnoreStandardErrorWarningFormat="true" />
  </Target>

  <Target Name="_SetupCocoaSDK"
          DependsOnTargets="_DownloadCocoaSDK;_BuildCocoaSDK;_GenerateSentryCocoaBindings"
          Condition="$([MSBuild]::IsOSPlatform('OSX'))" />

  <!-- Outer build (multi-TFM): runs _SetupCocoaSDK once before MSBuild fans out to inner per-TFM builds.  -->
  <Target Name="SetupCocoaSDKBeforeOuterBuild" DependsOnTargets="_SetupCocoaSDK"
          Condition="$([MSBuild]::IsOSPlatform('OSX'))"
          BeforeTargets="DispatchToInnerBuilds" />

  <!--
    Inner build (single-TFM) or direct single-TFM invocation (-f flag): runs _SetupCocoaSDK as a
    direct dependency, without a recursive MSBuild call. The recursive call pattern caused a circular
    dependency (SetupCocoaSDK → BeforeBuild → SetupCocoaSDK) that newer MSBuild versions detect as an error.
    All subtargets are idempotent, so if the outer build already ran them this is a no-op.
  -->
  <Target Name="SetupCocoaSDK"
          DependsOnTargets="_SetupCocoaSDK"
          BeforeTargets="BeforeBuild"
          Condition="$([MSBuild]::IsOSPlatform('OSX'))" />

  <Target Name="CleanCocoaSDK" AfterTargets="Clean" Condition="$([MSBuild]::IsOSPlatform('OSX'))">
    <RemoveDir Directories="$(SentryCocoaCache)Carthage" ContinueOnError="true" />
  </Target>

  <!-- Generate bindings -->
  <Target Name="_GenerateSentryCocoaBindings"
          Condition="$([MSBuild]::IsOSPlatform('OSX'))"
          Inputs="$(SentryCocoaBindingInputs)"
          Outputs="ApiDefinitions.cs;StructsAndEnums.cs">
    <MSBuild Projects="$(MSBuildProjectFile)" Targets="_InnerGenerateSentryCocoaBindings" Properties="TargetFramework=once" />
  </Target>
  <Target Name="_InnerGenerateSentryCocoaBindings">
    <Exec Command="pwsh ../../scripts/generate-cocoa-bindings.ps1" />
    <!-- See https://github.com/getsentry/sentry-dotnet/pull/2558 -->
    <Exec Condition="'$(GITHUB_ACTIONS)' == 'true'" Command="pwsh ../../scripts/dirty-check.ps1 -PathToCheck $(MSBuildThisFileDirectory)" />
  </Target>

  <!-- Workaround for https://github.com/xamarin/xamarin-macios/issues/15299. -->
  <Target Name="_SetGeneratedSupportDelegatesInternal" BeforeTargets="CoreCompile"
    Condition="$([MSBuild]::IsOSPlatform('OSX')) And Exists('$(GeneratedSourcesDir)SupportDelegates.g.cs')"
    Inputs="$(GeneratedSourcesDir)SupportDelegates.g.cs" Outputs="$(GeneratedSourcesDir)SupportDelegates.g.cs.stamp">
    <PropertyGroup>
      <GeneratedSupportDelegatesFile>$(GeneratedSourcesDir)SupportDelegates.g.cs</GeneratedSupportDelegatesFile>
    </PropertyGroup>
    <Message Text="Patching $(MSBuildThisFileDirectory)$(GeneratedSupportDelegatesFile)" Importance="High" />
    <WriteLinesToFile
      File="$(GeneratedSupportDelegatesFile)"
      Lines="$([System.IO.File]::ReadAllText($(GeneratedSupportDelegatesFile)).Replace('public delegate','internal delegate'))"
      Overwrite="true" />
    <Touch Files="$(GeneratedSupportDelegatesFile).stamp" AlwaysCreate="true" />
  </Target>

</Project>
