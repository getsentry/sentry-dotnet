<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Official Quartz.NET integration for Sentry - Open-source error tracking that helps developers monitor and fix crashes in real time.</Description>
    <PackageTags>$(PackageTags);Quartz;Crons</PackageTags>
    <TargetFrameworks>$(CurrentTfms);net462</TargetFrameworks>
  </PropertyGroup>

  <PropertyGroup Condition="'$(EnableAot)' == 'true'">
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Sentry\Sentry.csproj" />
    <PackageReference Include="Quartz" Version="3.6.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Sentry.Quartz.Tests" PublicKey="$(SentryPublicKey)" />
  </ItemGroup>

</Project>
