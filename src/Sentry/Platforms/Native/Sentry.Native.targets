<Project>

  <PropertyGroup>
    <SentryNativeSourceDirectory>$(MSBuildThisFileDirectory)..\..\..\..\modules\sentry-native\</SentryNativeSourceDirectory>
    <SentryNativeLibraryName>sentry-native</SentryNativeLibraryName>
    <SentryNativeBuildScript>$(MSBuildThisFileDirectory)..\..\..\..\scripts\build-sentry-native.ps1</SentryNativeBuildScript>
    <_SentryNativeDotGit>$(SentryNativeSourceDirectory).git</_SentryNativeDotGit>
    <_SentryNativeGitDir Condition="Exists('$(_SentryNativeDotGit)\HEAD')">$(_SentryNativeDotGit)\</_SentryNativeGitDir>
    <_SentryNativeGitDir Condition="'$(_SentryNativeGitDir)' == '' and Exists('$(_SentryNativeDotGit)')">$([MSBuild]::NormalizeDirectory('$(SentryNativeSourceDirectory)', $([System.IO.File]::ReadAllText('$(_SentryNativeDotGit)').Replace('gitdir:', '').Trim())))</_SentryNativeGitDir>
    <_SentryNativeGitHead Condition="'$(_SentryNativeGitDir)' != ''">$(_SentryNativeGitDir)HEAD</_SentryNativeGitHead>
    <SentryNativeBuildInputs>$(_SentryNativeGitHead);$(MSBuildThisFileDirectory)Sentry.Native.targets;$(SentryNativeBuildScript);$(MSBuildThisFileDirectory)CMakeLists.txt;$(MSBuildThisFileDirectory)sentry-preload.c</SentryNativeBuildInputs>
    <SentryNativeOutputDirectory>$(MSBuildThisFileDirectory)sentry-native\</SentryNativeOutputDirectory>
    <!-- List of runtime identifiers: https://github.com/dotnet/runtime/blob/main/src/libraries/Microsoft.NETCore.Platforms/src/runtime.json -->
    <NativeLibRelativePath-win-x64>win-x64</NativeLibRelativePath-win-x64>
    <SentryNativeOutputDirectory-win-x64>$(SentryNativeOutputDirectory)$(NativeLibRelativePath-win-x64)\</SentryNativeOutputDirectory-win-x64>
    <NativeLibRelativePath-win-arm64>win-arm64</NativeLibRelativePath-win-arm64>
    <SentryNativeOutputDirectory-win-arm64>$(SentryNativeOutputDirectory)$(NativeLibRelativePath-win-arm64)\</SentryNativeOutputDirectory-win-arm64>
    <NativeLibRelativePath-linux-x64>linux-x64</NativeLibRelativePath-linux-x64>
    <SentryNativeOutputDirectory-linux-x64>$(SentryNativeOutputDirectory)$(NativeLibRelativePath-linux-x64)\</SentryNativeOutputDirectory-linux-x64>
    <NativeLibRelativePath-linux-musl-x64>linux-musl-x64</NativeLibRelativePath-linux-musl-x64>
    <SentryNativeOutputDirectory-linux-musl-x64>$(SentryNativeOutputDirectory)$(NativeLibRelativePath-linux-musl-x64)\</SentryNativeOutputDirectory-linux-musl-x64>
    <NativeLibRelativePath-linux-arm64>linux-arm64</NativeLibRelativePath-linux-arm64>
    <SentryNativeOutputDirectory-linux-arm64>$(SentryNativeOutputDirectory)$(NativeLibRelativePath-linux-arm64)\</SentryNativeOutputDirectory-linux-arm64>
    <NativeLibRelativePath-linux-musl-arm64>linux-musl-arm64</NativeLibRelativePath-linux-musl-arm64>
    <SentryNativeOutputDirectory-linux-musl-arm64>$(SentryNativeOutputDirectory)$(NativeLibRelativePath-linux-musl-arm64)\</SentryNativeOutputDirectory-linux-musl-arm64>
    <NativeLibRelativePath-osx>osx</NativeLibRelativePath-osx>
    <SentryNativeOutputDirectory-osx>$(SentryNativeOutputDirectory)$(NativeLibRelativePath-osx)\</SentryNativeOutputDirectory-osx>
    <SentryNativeBuildOutputs Condition="'$(RuntimeIdentifier)' == 'win-x64'">$(SentryNativeOutputDirectory-win-x64)lib$(SentryNativeLibraryName).lib</SentryNativeBuildOutputs>
    <SentryNativeBuildOutputs Condition="'$(RuntimeIdentifier)' == 'win-arm64'">$(SentryNativeOutputDirectory-win-arm64)lib$(SentryNativeLibraryName).lib</SentryNativeBuildOutputs>
    <SentryNativeBuildOutputs Condition="'$(RuntimeIdentifier)' == 'linux-x64'">$(SentryNativeOutputDirectory-linux-x64)lib$(SentryNativeLibraryName).a;$(SentryNativeOutputDirectory)$(RuntimeIdentifier)\libunwind.a;$(SentryNativeOutputDirectory)$(RuntimeIdentifier)\sentry-preload.o</SentryNativeBuildOutputs>
    <SentryNativeBuildOutputs Condition="'$(RuntimeIdentifier)' == 'linux-musl-x64'">$(SentryNativeOutputDirectory-linux-musl-x64)lib$(SentryNativeLibraryName).a;$(SentryNativeOutputDirectory)$(RuntimeIdentifier)\libunwind.a;$(SentryNativeOutputDirectory)$(RuntimeIdentifier)\sentry-preload.o</SentryNativeBuildOutputs>
    <SentryNativeBuildOutputs Condition="'$(RuntimeIdentifier)' == 'linux-arm64'">$(SentryNativeOutputDirectory-linux-arm64)lib$(SentryNativeLibraryName).a;$(SentryNativeOutputDirectory)$(RuntimeIdentifier)\libunwind.a;$(SentryNativeOutputDirectory)$(RuntimeIdentifier)\sentry-preload.o</SentryNativeBuildOutputs>
    <SentryNativeBuildOutputs Condition="'$(RuntimeIdentifier)' == 'linux-musl-arm64'">$(SentryNativeOutputDirectory-linux-musl-arm64)lib$(SentryNativeLibraryName).a;$(SentryNativeOutputDirectory)$(RuntimeIdentifier)\libunwind.a;$(SentryNativeOutputDirectory)$(RuntimeIdentifier)\sentry-preload.o</SentryNativeBuildOutputs>
    <SentryNativeBuildOutputs Condition="$([MSBuild]::IsOsPlatform('OSX'))">$(SentryNativeOutputDirectory-osx)lib$(SentryNativeLibraryName).a;$(SentryNativeOutputDirectory-osx)sentry-preload.o</SentryNativeBuildOutputs>
  </PropertyGroup>

  <!-- The native backend variant, built with build-sentry-native.ps1 -Backend native -->
  <PropertyGroup>
    <SentryNativeBuildInputs>$(SentryNativeBuildInputs);$(MSBuildThisFileDirectory)sentry-crash-transport.c;$(MSBuildThisFileDirectory)NativeHttpClient.cs;$(MSBuildThisFileDirectory)..\..\..\Sentry.Native.Transport\NativeHttpClient.Daemon.cs</SentryNativeBuildInputs>
    <SentryNativeBuildOutputs Condition="'$(RuntimeIdentifier)' == 'win-x64' or '$(RuntimeIdentifier)' == 'win-arm64'">$(SentryNativeBuildOutputs);$(SentryNativeOutputDirectory)$(RuntimeIdentifier)\native\sentry-crash.exe;$(SentryNativeOutputDirectory)$(RuntimeIdentifier)\native\sentry-crash-transport.dll</SentryNativeBuildOutputs>
    <SentryNativeBuildOutputs Condition="$(RuntimeIdentifier.StartsWith('linux-'))">$(SentryNativeBuildOutputs);$(SentryNativeOutputDirectory)$(RuntimeIdentifier)\native\sentry-crash;$(SentryNativeOutputDirectory)$(RuntimeIdentifier)\native\sentry-crash-transport.so</SentryNativeBuildOutputs>
    <SentryNativeBuildOutputs Condition="$([MSBuild]::IsOsPlatform('OSX'))">$(SentryNativeBuildOutputs);$(SentryNativeOutputDirectory-osx)native\sentry-crash;$(SentryNativeOutputDirectory-osx)native\sentry-crash-transport.dylib</SentryNativeBuildOutputs>
  </PropertyGroup>

  <!-- Packaging -->
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)buildTransitive\Sentry.Native.targets" Pack="true" PackagePath="buildTransitive\Sentry.Native.targets" />
    <None Include="$(MSBuildThisFileDirectory)buildTransitive\Sentry.Native.targets" Pack="true" PackagePath="build\Sentry.Native.targets" />
  </ItemGroup>

  <!-- Packaging the native library (NOTE: $(RuntimeIdentifier) is not set) -->
  <ItemGroup Condition="'$(CI_PUBLISHING_BUILD)' == 'true' or '$(NETCoreSdkRuntimeIdentifier)' == 'win-x64'">
    <None Include="$(SentryNativeOutputDirectory-win-x64)$(SentryNativeLibraryName).lib">
      <Pack>true</Pack>
      <PackagePath>\sentry-native\$(NativeLibRelativePath-win-x64)</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup Condition="'$(CI_PUBLISHING_BUILD)' == 'true' or '$(NETCoreSdkRuntimeIdentifier)' == 'win-arm64'">
    <None Include="$(SentryNativeOutputDirectory-win-arm64)$(SentryNativeLibraryName).lib">
      <Pack>true</Pack>
      <PackagePath>\sentry-native\$(NativeLibRelativePath-win-arm64)</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup Condition="'$(CI_PUBLISHING_BUILD)' == 'true' or '$(NETCoreSdkRuntimeIdentifier)' == 'linux-x64'">
    <None Include="$(SentryNativeOutputDirectory-linux-x64)lib$(SentryNativeLibraryName).a;$(SentryNativeOutputDirectory-linux-x64)libunwind.a;$(SentryNativeOutputDirectory-linux-x64)sentry-preload.o">
      <Pack>true</Pack>
      <PackagePath>\sentry-native\$(NativeLibRelativePath-linux-x64)</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup Condition="'$(CI_PUBLISHING_BUILD)' == 'true' or '$(NETCoreSdkRuntimeIdentifier)' == 'linux-musl-x64'">
    <None Include="$(SentryNativeOutputDirectory-linux-musl-x64)lib$(SentryNativeLibraryName).a;$(SentryNativeOutputDirectory-linux-musl-x64)libunwind.a;$(SentryNativeOutputDirectory-linux-musl-x64)sentry-preload.o">
      <Pack>true</Pack>
      <PackagePath>\sentry-native\$(NativeLibRelativePath-linux-musl-x64)</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup Condition="'$(CI_PUBLISHING_BUILD)' == 'true' or '$(NETCoreSdkRuntimeIdentifier)' == 'linux-arm64'">
    <None Include="$(SentryNativeOutputDirectory-linux-arm64)lib$(SentryNativeLibraryName).a;$(SentryNativeOutputDirectory-linux-arm64)libunwind.a;$(SentryNativeOutputDirectory-linux-arm64)sentry-preload.o">
      <Pack>true</Pack>
      <PackagePath>\sentry-native\$(NativeLibRelativePath-linux-arm64)</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup Condition="'$(CI_PUBLISHING_BUILD)' == 'true' or '$(NETCoreSdkRuntimeIdentifier)' == 'linux-musl-arm64'">
    <None Include="$(SentryNativeOutputDirectory-linux-musl-arm64)lib$(SentryNativeLibraryName).a;$(SentryNativeOutputDirectory-linux-musl-arm64)libunwind.a;$(SentryNativeOutputDirectory-linux-musl-arm64)sentry-preload.o">
      <Pack>true</Pack>
      <PackagePath>\sentry-native\$(NativeLibRelativePath-linux-musl-arm64)</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup Condition="'$(CI_PUBLISHING_BUILD)' == 'true' or $([MSBuild]::IsOsPlatform('OSX'))">
    <None Include="$(SentryNativeOutputDirectory-osx)lib$(SentryNativeLibraryName).a;$(SentryNativeOutputDirectory-osx)sentry-preload.o">
      <Pack>true</Pack>
      <PackagePath>\sentry-native\$(NativeLibRelativePath-osx)</PackagePath>
    </None>
  </ItemGroup>

  <!-- Packaging the native backend variant -->
  <ItemGroup Condition="'$(CI_PUBLISHING_BUILD)' == 'true' or '$(NETCoreSdkRuntimeIdentifier)' == 'win-x64'">
    <None Include="$(SentryNativeOutputDirectory-win-x64)native\$(SentryNativeLibraryName).lib;$(SentryNativeOutputDirectory-win-x64)native\sentry-crash.exe;$(SentryNativeOutputDirectory-win-x64)native\sentry-wer.dll;$(SentryNativeOutputDirectory-win-x64)native\sentry-crash-transport.dll">
      <Pack>true</Pack>
      <PackagePath>\sentry-native\$(NativeLibRelativePath-win-x64)\native</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup Condition="'$(CI_PUBLISHING_BUILD)' == 'true' or '$(NETCoreSdkRuntimeIdentifier)' == 'win-arm64'">
    <None Include="$(SentryNativeOutputDirectory-win-arm64)native\$(SentryNativeLibraryName).lib;$(SentryNativeOutputDirectory-win-arm64)native\sentry-crash.exe;$(SentryNativeOutputDirectory-win-arm64)native\sentry-wer.dll;$(SentryNativeOutputDirectory-win-arm64)native\sentry-crash-transport.dll">
      <Pack>true</Pack>
      <PackagePath>\sentry-native\$(NativeLibRelativePath-win-arm64)\native</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup Condition="'$(CI_PUBLISHING_BUILD)' == 'true' or '$(NETCoreSdkRuntimeIdentifier)' == 'linux-x64'">
    <None Include="$(SentryNativeOutputDirectory-linux-x64)native\lib$(SentryNativeLibraryName).a;$(SentryNativeOutputDirectory-linux-x64)native\libunwind.a;$(SentryNativeOutputDirectory-linux-x64)native\sentry-preload.o;$(SentryNativeOutputDirectory-linux-x64)native\sentry-crash;$(SentryNativeOutputDirectory-linux-x64)native\sentry-crash-transport.so">
      <Pack>true</Pack>
      <PackagePath>\sentry-native\$(NativeLibRelativePath-linux-x64)\native</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup Condition="'$(CI_PUBLISHING_BUILD)' == 'true' or '$(NETCoreSdkRuntimeIdentifier)' == 'linux-musl-x64'">
    <None Include="$(SentryNativeOutputDirectory-linux-musl-x64)native\lib$(SentryNativeLibraryName).a;$(SentryNativeOutputDirectory-linux-musl-x64)native\libunwind.a;$(SentryNativeOutputDirectory-linux-musl-x64)native\sentry-preload.o;$(SentryNativeOutputDirectory-linux-musl-x64)native\sentry-crash;$(SentryNativeOutputDirectory-linux-musl-x64)native\sentry-crash-transport.so">
      <Pack>true</Pack>
      <PackagePath>\sentry-native\$(NativeLibRelativePath-linux-musl-x64)\native</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup Condition="'$(CI_PUBLISHING_BUILD)' == 'true' or '$(NETCoreSdkRuntimeIdentifier)' == 'linux-arm64'">
    <None Include="$(SentryNativeOutputDirectory-linux-arm64)native\lib$(SentryNativeLibraryName).a;$(SentryNativeOutputDirectory-linux-arm64)native\libunwind.a;$(SentryNativeOutputDirectory-linux-arm64)native\sentry-preload.o;$(SentryNativeOutputDirectory-linux-arm64)native\sentry-crash;$(SentryNativeOutputDirectory-linux-arm64)native\sentry-crash-transport.so">
      <Pack>true</Pack>
      <PackagePath>\sentry-native\$(NativeLibRelativePath-linux-arm64)\native</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup Condition="'$(CI_PUBLISHING_BUILD)' == 'true' or '$(NETCoreSdkRuntimeIdentifier)' == 'linux-musl-arm64'">
    <None Include="$(SentryNativeOutputDirectory-linux-musl-arm64)native\lib$(SentryNativeLibraryName).a;$(SentryNativeOutputDirectory-linux-musl-arm64)native\libunwind.a;$(SentryNativeOutputDirectory-linux-musl-arm64)native\sentry-preload.o;$(SentryNativeOutputDirectory-linux-musl-arm64)native\sentry-crash;$(SentryNativeOutputDirectory-linux-musl-arm64)native\sentry-crash-transport.so">
      <Pack>true</Pack>
      <PackagePath>\sentry-native\$(NativeLibRelativePath-linux-musl-arm64)\native</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup Condition="'$(CI_PUBLISHING_BUILD)' == 'true' or $([MSBuild]::IsOsPlatform('OSX'))">
    <None Include="$(SentryNativeOutputDirectory-osx)native\lib$(SentryNativeLibraryName).a;$(SentryNativeOutputDirectory-osx)native\sentry-preload.o;$(SentryNativeOutputDirectory-osx)native\sentry-crash;$(SentryNativeOutputDirectory-osx)native\sentry-crash-transport.dylib">
      <Pack>true</Pack>
      <PackagePath>\sentry-native\$(NativeLibRelativePath-osx)\native</PackagePath>
    </None>
  </ItemGroup>

  <Target Name="CleanNativeSDK" BeforeTargets="CoreClean" Condition="'$(TargetFramework)' != '' and $([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net8.0'))">
    <Message Text="Inside Custom Clean" Importance="high"/>
    <RemoveDir Directories="$(SentryNativeOutputDirectory)" />
    <RemoveDir Directories="$(SentryNativeSourceDirectory)build" />
    <RemoveDir Directories="$(SentryNativeSourceDirectory)build-native" />
  </Target>

  <!-- Build the Sentry Native SDK (this only runs on local machines because in CI we expect the SDK to be
       built already on each native platform and fetched for the final .net build. -->
  <Target Name="_BuildSentryNativeSDK"
    Inputs="$(SentryNativeBuildInputs)"
    Outputs="$(SentryNativeBuildOutputs)">
    <!-- We want a "-Clean" because if the build script changes, previous cmake cache may contain invalid defines. -->
    <Exec Command="pwsh $(SentryNativeBuildScript) -Clean" />
    <Exec Command="pwsh $(SentryNativeBuildScript) -Backend native -Clean" />
  </Target>

  <Target Name="_BuildSentryNativeSDKBeforeInnerBuild"
    Condition="'$(TargetFramework)' != '' and $([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net8.0')) and '$(CI)' != 'true'"
    BeforeTargets="BeforeBuild">
    <MSBuild Projects="$(MSBuildProjectFullPath)"
      Targets="_BuildSentryNativeSDK"
      RemoveProperties="TargetFramework" />
  </Target>
</Project>
